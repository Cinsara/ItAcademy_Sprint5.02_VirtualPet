        public Store() {
                foods.add(Food.builder().name("Apple").healthChange(10).happinessChange(5).hungerChange(-10).price(5).description("A healthy fruit").build());
                foods.add(Food.builder().name("Pizza").healthChange(-10).happinessChange(20).hungerChange(-15).price(10).description("A tasty unhealthy food").build());
                // Añadir el resto de alimentos
            }

            public List<Food> getAvailableFoods() {
                return foods;
            }

            // Puedes también acceder por nombre si lo prefieres
            public Food getFoodByName(String name) {
                return foods.stream()
                            .filter(food -> food.getName().equals(name))
                            .findFirst()
                            .orElseThrow(() -> new RuntimeException("Food not found"));
            }
        }

